    \begin{column}{\colwidth}

      \begin{alertblock}{R2OMC: In a nutshell}
        \Centering
        \Large{SBI with a \emph{differentiable} simulator? \\
          $\Rightarrow$ R2OMC infers accurate posterior samples efficiently}
      \end{alertblock}

      \begin{block}{Speed vs.\ Accuracy vs.\ Transparency in SBI}
        \textbf{Traditional LFI methods} (ABC, SMC-ABC, MCMC-ABC) are transparent
        but do not scale beyond low-dimensional parameter spaces.

        \textbf{Modern neural methods} (NPE, BayesFlow, FMPE) scale to high
        dimensions but require large simulation budgets, long runtimes,
        and sacrifice transparency.

        \textbf{R2OMC} is fast (low simulation budget), scalable
        (high-dimensional spaces), and transparent (no neural network).

        \vspace{0.5em}
        \begin{figure}[ht]
          \centering
          \setlength{\tabcolsep}{0.1pt}
