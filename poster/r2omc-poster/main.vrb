      \begin{defbox}{R2OMC builds on top of OMC and ROMC}
        \begin{itemize}
          \item \textcolor{blue}{\textbf{OMC} (Meeds et al., 2015) and \textbf{ROMC} (Ikonomov et al., 2020):}
            \begin{itemize}
              \item fix random seeds $\ub_i$ and turn inference into $S$ deterministic problems
              \item ABC likelihood: $L_\epsilon(\thetab) = \Pr\!\left(d(\yb,\yb^o) \le \epsilon \mid \thetab\right)$.
              \item $\thetab^*_i = \arg\min_{\thetab}\; d\!\left(g(\thetab,\ub_i),\,\yb^o\right)$; samples drawn from proposals $q_i$ around each optimum.
            \end{itemize}
          \item \textcolor{red}{\textbf{Limitations of vanilla ROMC:}}
            \begin{itemize}
              \item No strategy for \textbf{distractors} -- inflated $\epsilon$, broad posteriors.
              \item No strategy for \textbf{multiple iid observations}.
              \item No optimized implementation -- can only tackle low-dim problems.
            \end{itemize}
        \end{itemize}
      \end{defbox}

      \begin{block}{R2OMC: Method overview}
        \begin{figure}
          \centering
          \includegraphics[width=0.92\linewidth]{../figures/concept_image.png}
        \end{figure}

        \smallskip
        \textbf{\textcolor{blue}{Gradient-based optimization.}} \\
        Distances $d_n(\thetab) = \|g(\thetab,\ub_i) - \yb^o_n\|$ minimized via gradient descent; scales to high-dimensional $\thetab$.

        \smallskip
        \textbf{\textcolor{red}{Distractor filtering.}} \\
        Average gradient norm per output dimension thresholded at $\tau$:
        $\;I_i = \mathbb{E}_{p(\thetab)p(\ub)}\!\left[\,\|\nabla_{\thetab} g_i(\thetab,\ub)\|\,\right] > \tau.$
        Optimization runs only on informative dimensions $\mathbf{m}_\tau$.

        \smallskip
        \textbf{\textcolor{magenta}{Multiple iid observations.}} \\
        Per-observation proposals combined: $\;q(\thetab) = \tfrac{1}{NS}\sum_{n,i} q^n_i(\thetab)$,
        with weights $\;w_p = \tfrac{p(\thetab_p)}{q(\thetab_p)}\prod_{n}\sum_{i}\mathbf{1}_{C^{i,n}_\epsilon}(\thetab_p)$
        retaining samples consistent with \emph{all} observations.

        \smallskip
        \textbf{\textcolor{teal}{\texttt{JAX} implementation.}} \\
        \texttt{grad} for Jacobians, \texttt{vmap} vectorizes over seeds and dimensions, \texttt{jit} fuses optimization steps.
      \end{block}


      \begin{block}{{\color{teal} How to use R2OMC}}
\textbf{Install:} \quad \texttt{pip install git+https://github.com/givasile/lfi}

\vspace{0.5em}
\begin{lstlisting}[language=Python]
from lfi import priors, simulators, inference

prior     = priors.UniformPrior(low=-3, high=3, dim=2) # or your own prior
simulator = simulators.TwoMoons(dim=2, dim_y=2)        # or your own simulator
y_obs     = ...                                        # shape (N_obs, D_y)

model = inference.r2omc.R2OMC(prior, simulator, y_obs)
model.fit(budget=500)
samples = model.sample(nof_samples=1000)
\end{lstlisting}
      \end{block}

